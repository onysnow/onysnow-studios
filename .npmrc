# @tanstack/react-start@1.168.32 depends on @tanstack/react-router@1.170.18
# exactly, while @tanstack/react-router-ssr-query@1.167.3 -- the latest, and
# what package.json asks for -- peer-requires >=1.170.33. Those two cannot both
# be satisfied, so a plain `npm install` fails with ERESOLVE on a clean
# checkout. It is an upstream incompatibility, not something this project did.
#
# Recorded here rather than left as a flag people have to know about, so that
# `npm install` and `npm ci` work out of the box. The resolution that comes out
# of it is the one package-lock.json pins and the one CI and this workspace
# have been building and testing against.
#
# The real fix is bumping @tanstack/react-start to a release that depends on a
# router new enough for ssr-query. That is a framework upgrade and wants doing
# deliberately, not as a side effect of adding a lockfile.
legacy-peer-deps=true
